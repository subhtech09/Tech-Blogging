{
  "routes": [
    {
      "route": "/admin",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/admin/*",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/moderate*",
      "redirect": "/admin/",
      "statusCode": 301
    },
    {
      "route": "/write",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/write/*",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/api/manage/*",
      "allowedRoles": [
        "admin"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=/admin/",
      "statusCode": 302
    },
    "404": {
      "rewrite": "/404.html"
    }
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
