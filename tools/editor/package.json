{
  "name": "intelligence-stack-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Builds assets/js/editor.bundle.js (TipTap editor for the /write/ page). Run: npm install && npm run build",
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --format=iife --target=es2019 --legal-comments=eof --outfile=../../assets/js/editor.bundle.js"
  },
  "devDependencies": {
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-heading": "2.27.3",
    "@tiptap/extension-highlight": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/extension-table": "2.27.3",
    "@tiptap/extension-table-cell": "2.27.3",
    "@tiptap/extension-table-header": "2.27.3",
    "@tiptap/extension-table-row": "2.27.3",
    "@tiptap/extension-underline": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "esbuild": "0.28.2"
  }
}
